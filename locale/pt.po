"Vulkan 32 bits (AMD) — necessário para Steam, Wine/Proton e jogos antigos"

#: usr/share/big-kernel-manager/ui/mesa_data.py:114
msgid "Vulkan for Intel GPUs"
msgstr "Vulkan para GPUs Intel"

#: usr/share/big-kernel-manager/ui/mesa_data.py:121
msgid "32-bit Vulkan (Intel) — needed by Steam, Wine/Proton and older games"
