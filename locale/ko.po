# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 152
#: usr/share/big-kernel-manager/ui/mesa_data.py:152
msgid ""
"Hardware-accelerated video decoding (VAAPI/VDPAU). Makes videos, streaming and video calls smoother "
"while reducing CPU and power usage."
msgstr "하드웨어 가속 비디오 디코딩(VAAPI/VDPAU). CPU 및 전력 사용량을 줄이면서 비디오, 스트리밍 및 화상 통화를 더욱 원활하게 만듭니다."
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 159
#: usr/share/big-kernel-manager/ui/mesa_data.py:159
msgid "VAAPI for NVIDIA proprietary driver"
msgstr "NVIDIA 독점 드라이버용 VAAPI"
# 
