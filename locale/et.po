"32-bitine Vulkan (AMD) – vajalik Steami, Wine/Protoni ja vanemate mängude "
"jaoks"

#: usr/share/big-kernel-manager/ui/mesa_data.py:106
msgid "32-bit Vulkan (AMD) — needed by Steam, Wine/Proton and older games"
msgstr ""
"32-bitine Vulkan (AMD) – vajalik Steami, Wine/Protoni ja vanemate mängude "
"jaoks"

#: usr/share/big-kernel-manager/ui/mesa_data.py:114
msgid "Vulkan for Intel GPUs"
msgstr "Vulkan Inteli GPU-de jaoks"

#: usr/share/big-kernel-manager/ui/mesa_data.py:121
msgid "32-bit Vulkan (Intel) — needed by Steam, Wine/Proton and older games"
msgstr ""
"Avatud lähtekoodiga Vulkan NVIDIA jaoks (Nouveau) – patenteeritud draiverit "
"pole vaja"

#: usr/share/big-kernel-manager/ui/mesa_data.py:130
