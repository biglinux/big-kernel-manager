msgid "Amber: Stable and well-tested version"
msgstr "Amber: Стабилна и добре тествана версия"
#: /home/talesam/Servidor/GitHub/big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py:240
msgid "Stable: Regular Mesa release"
msgstr "Стабилна: Редовна версия на Mesa"
#: /home/talesam/Servidor/GitHub/big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py:241
msgid "Tkg-Stable: Enhanced performance build"
msgstr "Tkg-Stable: Подобрена производителност"
#: /home/talesam/Servidor/GitHub/big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py:242
msgid "Tkg-git: Latest development version with cutting-edge features"
msgstr "Tkg-git: Най-новата версия с най-модерни функции"
#: /home/talesam/Servidor/GitHub/big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py:243
msgid "Choose the one that best fits your needs and hardware."
msgstr "Изберете този, който най-добре отговаря на вашите нужди и хардуер."
#: /home/talesam/Servidor/GitHub/big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py:245
