msgstr "Tkg-Stable: Βελτιωμένη απόδοση"
#: /home/talesam/Servidor/GitHub/big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py:242
msgid "Tkg-git: Latest development version with cutting-edge features"
msgstr "Tkg-git: Τελευταία έκδοση ανάπτυξης με πρωτοποριακές λειτουργίες"
#: /home/talesam/Servidor/GitHub/big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py:243
