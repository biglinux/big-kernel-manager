#: usr/share/big-kernel-manager/ui/mesa_data.py:90
msgid "Gaming & 3D Graphics"
msgstr "Jocuri și grafică 3D"

#: usr/share/big-kernel-manager/ui/mesa_data.py:93
msgid ""
"Vulkan and OpenGL libraries essential for games, Steam, Wine/Proton and 3D "
"applications."
msgstr ""
"Bibliotecile Vulkan și OpenGL esențiale pentru jocuri, Steam, Wine/Proton și "
"aplicații 3D."

#: usr/share/big-kernel-manager/ui/mesa_data.py:99
msgid "Vulkan for AMD Radeon GPUs"
msgstr ""
"Vulkan pe 32 de biți (AMD) — necesar pentru jocurile Steam, Wine/Proton și "
"mai vechi"

#: usr/share/big-kernel-manager/ui/mesa_data.py:106
msgid "32-bit Vulkan (AMD) — needed by Steam, Wine/Proton and older games"
msgstr ""
"Vulkan pe 32 de biți (AMD) — necesar pentru jocurile Steam, Wine/Proton și "
"mai vechi"

#: usr/share/big-kernel-manager/ui/mesa_data.py:114
msgid "Vulkan for Intel GPUs"
msgstr "Vulkan pentru GPU-uri Intel"

#: usr/share/big-kernel-manager/ui/mesa_data.py:121
msgid "32-bit Vulkan (Intel) — needed by Steam, Wine/Proton and older games"
msgstr ""
"Vulkan pe 32 de biți (Intel) — necesar pentru jocurile Steam, Wine/Proton și "
"mai vechi"

#: usr/share/big-kernel-manager/ui/mesa_data.py:130
msgid "Open-source Vulkan for NVIDIA (Nouveau) — no proprietary driver needed"
msgstr ""
"Vulkan cu sursă deschisă pentru NVIDIA (Nouveau) — nu este necesar un driver "
"proprietar"

#: usr/share/big-kernel-manager/ui/mesa_data.py:139
msgid "32-bit OpenGL — needed by Steam, Wine/Proton and older 32-bit games"
msgstr ""
"OpenGL pe 32 de biți — necesar pentru jocurile Steam, Wine/Proton și mai "
"vechi pe 32 de biți"

#: usr/share/big-kernel-manager/ui/mesa_data.py:149
msgid "Video Playback"
msgstr "Redare video"

#: usr/share/big-kernel-manager/ui/mesa_data.py:152
msgid ""
"Hardware-accelerated video decoding (VAAPI/VDPAU). Makes videos, streaming "
"and video calls smoother while reducing CPU and power usage."
msgstr "Driver proprietar VAAPI pentru NVIDIA"

#: usr/share/big-kernel-manager/ui/mesa_data.py:159
msgid "VAAPI for NVIDIA proprietary driver"
msgstr "Driver proprietar VAAPI pentru NVIDIA"

#: usr/share/big-kernel-manager/ui/mesa_data.py:165
msgid "VAAPI for Intel (Broadwell / Gen 8 and newer)"
msgstr "VAAPI pentru Intel (Broadwell / Gen 8 și mai nou)"

#: usr/share/big-kernel-manager/ui/mesa_data.py:172
msgid "VAAPI for older Intel (Haswell to Coffee Lake / Gen 4–9)"
msgstr "VAAPI pentru Intel mai vechi (Haswell to Coffee Lake / Gen 4–9)"

#: usr/share/big-kernel-manager/ui/mesa_data.py:179
msgid "VAAPI for AMD and NVIDIA open-source (Nouveau)"
msgstr "VAAPI pentru AMD și NVIDIA open-source (Nouveau)"

#: usr/share/big-kernel-manager/ui/mesa_data.py:186
msgid ""
"VDPAU for AMD/NVIDIA open-source — legacy API being replaced by VAAPI and "
"Vulkan. Probably not needed."
msgstr ""
"VDPAU pentru AMD/NVIDIA open-source — API-ul moștenit fiind înlocuit de "
"VAAPI și Vulkan. Probabil nu este nevoie."

#: usr/share/big-kernel-manager/ui/mesa_data.py:197
msgid "GPU Compute (AI / ML)"
msgstr "Calcul GPU (AI / ML)"

#: usr/share/big-kernel-manager/ui/mesa_data.py:200
msgid ""
"CUDA and OpenCL libraries for artificial intelligence, machine learning, "
"Blender, DaVinci Resolve and other GPU-accelerated workloads."
msgstr ""
"Biblioteci CUDA și OpenCL pentru inteligență artificială, învățare automată, "
"Blender, DaVinci Resolve și alte sarcini de lucru accelerate de GPU."

#: usr/share/big-kernel-manager/ui/mesa_data.py:207
msgid "NVIDIA CUDA — TensorFlow, PyTorch, AI/ML"
msgstr "NVIDIA CUDA — TensorFlow, PyTorch, AI/ML"

#: usr/share/big-kernel-manager/ui/mesa_data.py:213
msgid "OpenCL for NVIDIA — Blender, DaVinci, Darktable"
msgstr "OpenCL pentru NVIDIA — Blender, DaVinci, Darktable"

#: usr/share/big-kernel-manager/ui/mesa_data.py:219
msgid "OpenCL for AMD — Blender, GIMP, DaVinci"
msgstr "OpenCL pentru AMD — Blender, GIMP, DaVinci"

#: usr/share/big-kernel-manager/ui/mesa_data.py:225
msgid "OpenCL for Intel — Blender, DaVinci"
msgstr "OpenCL pentru Intel — Blender, DaVinci"

#: usr/share/big-kernel-manager/ui/mesa_data.py:270
msgid "Stable"
msgstr "Stabil"

#: usr/share/big-kernel-manager/ui/mesa_data.py:272
msgid ""
"Officially tested by the Mesa team. The safest and most reliable choice for "
"everyday use, gaming, and video playback."
msgstr ""
"Testat oficial de echipa Mesa. Cea mai sigură și mai fiabilă alegere pentru "
"utilizarea de zi cu zi, jocuri și redare video."

