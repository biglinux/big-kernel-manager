msgstr "Uplatniť zmeny ovládača"
#: /home/talesam/Servidor/GitHub/big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py:266
msgid ""
"Are you sure you want to apply the selected driver changes?\n"
"\n"
"This will modify your system's video drivers and might require a reboot."
msgstr ""
"Naozaj chcete použiť vybrané zmeny ovládačov?\n"
"\n"
"Týmto sa upravia grafické ovládače vášho systému a môže byť potrebné reštartovať počítač."
#: /home/talesam/Servidor/GitHub/big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py:290
#, python-brace-format
msgid "Applying {}"
msgstr "Uplatňovanie {}"
