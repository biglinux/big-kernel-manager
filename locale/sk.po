msgstr ""
"Vulkan s otvoreným zdrojovým kódom pre NVIDIA (Nouveau) — nie je potrebný žiadny proprietárny "
"ovládač"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 139
#: usr/share/big-kernel-manager/ui/mesa_data.py:139
