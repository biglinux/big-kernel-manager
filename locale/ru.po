msgstr "32-битный OpenGL — необходим для Steam, Wine/Proton и более старых 32-битных игр."
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 149
#: usr/share/big-kernel-manager/ui/mesa_data.py:149
msgid "Video Playback"
msgstr "Воспроизведение видео"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 152
#: usr/share/big-kernel-manager/ui/mesa_data.py:152
msgid ""
"Hardware-accelerated video decoding (VAAPI/VDPAU). Makes videos, streaming and video calls smoother "
"while reducing CPU and power usage."
msgstr ""
"Аппаратное ускорение декодирования видео (VAAPI/VDPAU). Делает видео, потоковую передачу и "
"видеозвонки более плавными, одновременно снижая использование процессора и энергопотребления."
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 159
#: usr/share/big-kernel-manager/ui/mesa_data.py:159
msgid "VAAPI for NVIDIA proprietary driver"
msgstr "VAAPI для проприетарного драйвера NVIDIA"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 165
#: usr/share/big-kernel-manager/ui/mesa_data.py:165
msgid "VAAPI for Intel (Broadwell / Gen 8 and newer)"
msgstr "VAAPI для Intel (Broadwell/Gen 8 и новее)"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 172
#: usr/share/big-kernel-manager/ui/mesa_data.py:172
msgid "VAAPI for older Intel (Haswell to Coffee Lake / Gen 4–9)"
msgstr "VAAPI для старых моделей Intel (от Haswell до Coffee Lake / поколения 4–9)"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 179
#: usr/share/big-kernel-manager/ui/mesa_data.py:179
msgid "VAAPI for AMD and NVIDIA open-source (Nouveau)"
msgstr "VAAPI для AMD и NVIDIA с открытым исходным кодом (Nouveau)"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 186
#: usr/share/big-kernel-manager/ui/mesa_data.py:186
msgid ""
"VDPAU for AMD/NVIDIA open-source — legacy API being replaced by VAAPI and Vulkan. Probably not "
"needed."
msgstr ""
"VDPAU для AMD/NVIDIA с открытым исходным кодом — устаревший API заменяется VAAPI и Vulkan. "
"Наверное, не нужен."
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 197
#: usr/share/big-kernel-manager/ui/mesa_data.py:197
msgid "GPU Compute (AI / ML)"
msgstr "Вычисления на графическом процессоре (ИИ/МО)"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 200
#: usr/share/big-kernel-manager/ui/mesa_data.py:200
msgid ""
"CUDA and OpenCL libraries for artificial intelligence, machine learning, Blender, DaVinci Resolve "
"and other GPU-accelerated workloads."
msgstr ""
"Библиотеки CUDA и OpenCL для искусственного интеллекта, машинного обучения, Blender, DaVinci "
"Resolve и других рабочих нагрузок с ускорением на графическом процессоре."
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 207
#: usr/share/big-kernel-manager/ui/mesa_data.py:207
msgid "NVIDIA CUDA — TensorFlow, PyTorch, AI/ML"
msgstr "NVIDIA CUDA — TensorFlow, PyTorch, AI/ML"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 213
#: usr/share/big-kernel-manager/ui/mesa_data.py:213
msgid "OpenCL for NVIDIA — Blender, DaVinci, Darktable"
msgstr "OpenCL для NVIDIA — Blender, DaVinci, Darktable"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 219
#: usr/share/big-kernel-manager/ui/mesa_data.py:219
msgid "OpenCL for AMD — Blender, GIMP, DaVinci"
msgstr "OpenCL для AMD — Blender, GIMP, DaVinci"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 225
#: usr/share/big-kernel-manager/ui/mesa_data.py:225
msgid "OpenCL for Intel — Blender, DaVinci"
msgstr "OpenCL для Intel — Blender, DaVinci"
# 
