msgstr "32-битный Vulkan (Intel) — необходим для Steam, Wine/Proton и более старых игр."
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 130
#: usr/share/big-kernel-manager/ui/mesa_data.py:130
msgid "Open-source Vulkan for NVIDIA (Nouveau) — no proprietary driver needed"
msgstr "Vulkan с открытым исходным кодом для NVIDIA (Nouveau) — проприетарный драйвер не требуется"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 139
#: usr/share/big-kernel-manager/ui/mesa_data.py:139
