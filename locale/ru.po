# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py, line: 127
#: usr/share/big-kernel-manager/ui/mesa_page.py:127
msgid ""
"On Linux, video drivers for AMD, Intel and NVIDIA (free software Nouveau) are built into a single "
"project called <b>Mesa</b>. Below you can choose a Mesa variant and manage extra packages for "
"gaming, video playback, compute and AI."
msgstr ""
"В Linux видеодрайверы для AMD, Intel и NVIDIA (бесплатное программное обеспечение Nouveau) встроены "
"в единый проект под названием <b>Mesa</b>. Ниже вы можете выбрать вариант Mesa и управлять "
"дополнительными пакетами для игр, воспроизведения видео, вычислений и искусственного интеллекта."
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py, line: 150
#: usr/share/big-kernel-manager/ui/mesa_page.py:150
msgid ""
"Your computer has an <b>NVIDIA</b> graphics card. You can install the official proprietary driver "
"for the best performance in gaming, AI and professional applications."
msgstr ""
"На вашем компьютере установлена ​​видеокарта <b>NVIDIA</b>. Вы можете установить официальный "
"проприетарный драйвер для максимальной производительности в играх, AI и профессиональных "
"приложениях."
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py, line: 183
#: usr/share/big-kernel-manager/ui/mesa_page.py:183
msgid "Mesa Variant"
msgstr "Вариант Меса"
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_page.py, line: 194
#: usr/share/big-kernel-manager/ui/mesa_page.py:194
msgid "Choose which Mesa build to use. Only one variant can be active at a time."
msgstr "Выберите вариант Mesa. Одновременно может быть активен только один вариант."
