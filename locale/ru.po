msgstr "32-битный Vulkan (AMD) — необходим для Steam, Wine/Proton и более старых игр."
# 
# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 114
#: usr/share/big-kernel-manager/ui/mesa_data.py:114
msgid "Vulkan for Intel GPUs"
msgstr "Vulkan для графических процессоров Intel"
# 
