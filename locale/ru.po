# File: big-kernel-manager/usr/share/big-kernel-manager/ui/mesa_data.py, line: 272
#: usr/share/big-kernel-manager/ui/mesa_data.py:272
msgid ""
"Officially tested by the Mesa team. The safest and most reliable choice for everyday use, gaming, "
"and video playback."
msgstr ""
"Официально протестировано командой Mesa. Самый безопасный и надежный выбор для повседневного "
"использования, игр и воспроизведения видео."
# File: usr/share/big-kernel-manager/ui/mesa_page.py, line: 285
#: usr/share/big-kernel-manager/ui/drivers_hub_page.py:105
#: usr/share/big-kernel-manager/ui/mesa_data.py:275
